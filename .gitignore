*.opendb
*.VC.db
*.VC.opendb

# IDE / editor
.vs/
.idea/
*.xcodeproj
*.xcworkspace

# OS cruft
Desktop.ini
.DS_Store
Thumbs.db

# Python bytecode, left by Blender running the structure scripts
__pycache__/

# The AI overlay's Python side: a clone of StreamDiffusion with its own venv (see Structures/AI_OVERLAY.md)
StreamDiffusion/

# The packaged game (Tools/Package/package.bat, Structures/BUILD.md)
Packaged/
